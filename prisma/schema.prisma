generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SongStatus {
  DRAFT
  IN_PROGRESS
  READY
  PUBLISHED
  ARCHIVED
}

enum PlaylistType {
  COMPILATION
  SHORTS_SET
  MOOD_SET
  CUSTOM
}

enum AssetType {
  COVER_ART
  AUDIO_FULL
  AUDIO_SHORT
  VIDEO_SHORT
  VIDEO_FULL
  LYRICS_DOC
  OTHER
}

enum AssetStorageType {
  LOCAL
  EXTERNAL_URL
}

enum PublishPlatform {
  YOUTUBE
  WEBSITE
  WHATSAPP
  INSTAGRAM
  TIKTOK
  OTHER
}

enum PublishContentType {
  FULL_SONG
  SHORT
  PLAYLIST
  EXCERPT
  TEASER
  OTHER
}

enum ReleaseCampaignStatus {
  DRAFT
  PLANNING
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum ReleaseCampaignGoal {
  SONG_LAUNCH
  SHORTS_PUSH
  PLAYLIST_DROP
  WEBSITE_PUSH
  MIXED
}

enum CampaignItemType {
  SONG
  SHORT
  PLAYLIST
  WEBSITE_POST
  EXCERPT
  OTHER
}

enum ScheduledReleaseStatus {
  PLANNED
  SCHEDULED
  PUBLISHED
  SKIPPED
  CANCELED
}

enum ExternalSyncStatus {
  NONE
  LINKED
  SYNCED
  ERROR
}

enum AIGenerationKind {
  YOUTUBE_TITLE
  YOUTUBE_DESCRIPTION
  SHORT_VERSION
  EXCERPT
  TAGS
  HOOK_TEXT
  NOTES
  OTHER
}

model Song {
  id                 String            @id @default(cuid())
  title              String
  slug               String            @unique
  status             SongStatus        @default(DRAFT)
  mood               String?
  theme              String?
  language           String            @default("Spanish")
  fullLyrics         String?
  shortVersion       String?
  hookText           String?
  youtubeTitle       String?
  youtubeDescription String?
  websiteExcerpt     String?
  notes              String?
  hasCoverArt        Boolean           @default(false)
  hasFullVersion     Boolean           @default(false)
  hasShortVersion    Boolean           @default(false)
  publishedYoutube   Boolean           @default(false)
  publishedWebsite   Boolean           @default(false)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  tags               Tag[]
  playlistSongs      PlaylistSong[]
  assets             Asset[]
  aiGenerationLogs   AIGenerationLog[]
  publishEvents      PublishEvent[]
  campaignItems      CampaignItem[]
  scheduledReleases  ScheduledRelease[]
  analyticsSnapshots AnalyticsSnapshot[]

  @@index([status])
  @@index([updatedAt])
  @@index([mood])
  @@index([theme])
}

model Tag {
  id    String @id @default(cuid())
  name  String @unique
  slug  String @unique
  songs Song[]
}

model Playlist {
  id            String         @id @default(cuid())
  title         String
  slug          String         @unique
  description   String?
  type          PlaylistType   @default(CUSTOM)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  playlistSongs PlaylistSong[]
  campaignItems CampaignItem[]
  scheduledReleases ScheduledRelease[]

  @@index([type])
  @@index([updatedAt])
}

model PlaylistSong {
  playlistId String
  songId     String
  position   Int      @default(0)
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  song       Song     @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@id([playlistId, songId])
  @@index([songId])
  @@index([playlistId, position])
}

model Asset {
  id          String           @id @default(cuid())
  songId      String?
  type        AssetType        @default(OTHER)
  storageType AssetStorageType @default(EXTERNAL_URL)
  title       String
  fileName    String?
  mimeType    String?
  fileSize    Int?
  path        String?
  url         String?
  notes       String?
  isPrimary   Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  song        Song?            @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@index([songId])
  @@index([type])
  @@index([createdAt])
}

model AIGenerationLog {
  id        String           @id @default(cuid())
  songId    String?
  kind      AIGenerationKind @default(OTHER)
  provider  String           @default("mock")
  prompt    String
  result    String
  accepted  Boolean          @default(false)
  createdAt DateTime         @default(now())
  song      Song?            @relation(fields: [songId], references: [id], onDelete: SetNull)

  @@index([songId])
  @@index([kind])
  @@index([createdAt])
}

model PublishEvent {
  id          String             @id @default(cuid())
  songId      String
  platform    PublishPlatform    @default(OTHER)
  contentType PublishContentType @default(OTHER)
  publishedAt DateTime           @default(now())
  url         String?
  externalId  String?
  externalUrl String?
  thumbnailUrl String?
  syncStatus  ExternalSyncStatus @default(NONE)
  lastSyncedAt DateTime?
  syncError   String?
  notes       String?
  createdAt   DateTime           @default(now())
  song        Song               @relation(fields: [songId], references: [id], onDelete: Cascade)
  analyticsSnapshots AnalyticsSnapshot[]

  @@index([songId])
  @@index([platform])
  @@index([publishedAt])
  @@index([externalId])
  @@index([syncStatus])
}

model ReleaseCampaign {
  id                String                @id @default(cuid())
  title             String
  slug              String                @unique
  description       String?
  status            ReleaseCampaignStatus @default(DRAFT)
  goal              ReleaseCampaignGoal   @default(MIXED)
  startDate         DateTime?
  endDate           DateTime?
  notes             String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  items             CampaignItem[]
  scheduledReleases ScheduledRelease[]

  @@index([status])
  @@index([goal])
  @@index([startDate])
}

model CampaignItem {
  id         String           @id @default(cuid())
  campaignId String
  songId     String?
  playlistId String?
  itemType   CampaignItemType @default(OTHER)
  title      String?
  notes      String?
  priority   Int              @default(0)
  createdAt  DateTime         @default(now())
  campaign   ReleaseCampaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  song       Song?            @relation(fields: [songId], references: [id], onDelete: SetNull)
  playlist   Playlist?        @relation(fields: [playlistId], references: [id], onDelete: SetNull)

  @@index([campaignId])
  @@index([songId])
  @@index([playlistId])
  @@index([priority])
}

model ScheduledRelease {
  id          String                 @id @default(cuid())
  songId      String?
  playlistId  String?
  campaignId  String?
  platform    PublishPlatform        @default(OTHER)
  contentType PublishContentType     @default(OTHER)
  status      ScheduledReleaseStatus @default(PLANNED)
  title       String
  scheduledFor DateTime?
  publishedAt DateTime?
  notes       String?
  ctaText     String?
  url         String?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  song        Song?                  @relation(fields: [songId], references: [id], onDelete: SetNull)
  playlist    Playlist?              @relation(fields: [playlistId], references: [id], onDelete: SetNull)
  campaign    ReleaseCampaign?       @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([songId])
  @@index([playlistId])
  @@index([campaignId])
  @@index([platform])
  @@index([contentType])
  @@index([status])
  @@index([scheduledFor])
}

model UserPreference {
  id        String   @id @default(cuid())
  userId    String?
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model AnalyticsSnapshot {
  id             String          @id @default(cuid())
  songId         String?
  publishEventId String?
  platform       PublishPlatform @default(OTHER)
  snapshotDate   DateTime
  views          Int?
  likes          Int?
  comments       Int?
  shares         Int?
  watchTime      Int?
  ctr            Float?
  retention      Float?
  rawJson        Json?
  createdAt      DateTime        @default(now())
  song           Song?           @relation(fields: [songId], references: [id], onDelete: SetNull)
  publishEvent   PublishEvent?   @relation(fields: [publishEventId], references: [id], onDelete: SetNull)

  @@index([songId])
  @@index([publishEventId])
  @@index([platform])
  @@index([snapshotDate])
}

enum UserRole {
  USER
  ADMIN
}

enum ProjectStatus {
  IDEA
  DRAFTING
  REVISING
  COMPLETE
  ARCHIVED
}

enum FolderKind {
  MANUSCRIPT
  STORY_NOTES
  RESEARCH
  BRAINSTORM
  RESOURCES
  TRASH
}

enum DocumentKind {
  MANUSCRIPT
  STORY_NOTE
  RESEARCH
}

enum StoryNoteType {
  CHARACTER
  LOCATION
  SCENE_IDEA
  PLOT_THREAD
  TIMELINE_NOTE
  WORLDBUILDING
  GENERAL
}

enum ResourceLinkType {
  DOCUMENT
  STORY_NOTE
  RESEARCH_NOTE
  BRAINSTORM_CARD
}

enum LinkableType {
  DOCUMENT
  STORY_NOTE
  RESEARCH_NOTE
  BRAINSTORM_CARD
  RESOURCE
}

enum AIProvider {
  GROQ
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  displayName  String
  role         UserRole  @default(USER)
  disabled     Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions          Session[]
  projects          Project[]
  folders           Folder[]
  documents         Document[]
  documentVersions  DocumentVersion[]
  storyNotes        StoryNote[]
  researchNotes     ResearchNote[]
  brainstormBoards  BrainstormBoard[]
  brainstormCards   BrainstormCard[]
  resources         Resource[]
  aiSettings        AISettings?

  @@index([role])
  @@index([disabled])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Project {
  id          String        @id @default(cuid())
  title       String
  subtitle    String?
  description String?
  genre       String?
  status      ProjectStatus @default(IDEA)
  coverImage  String?
  userId      String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  folders           Folder[]
  documents         Document[]
  storyNotes        StoryNote[]
  researchNotes     ResearchNote[]
  brainstormBoards  BrainstormBoard[]
  brainstormColumns BrainstormColumn[]
  brainstormCards   BrainstormCard[]
  resources         Resource[]
  tags              WriterTag[]

  @@index([userId])
  @@index([status])
  @@index([updatedAt])
}

model Folder {
  id        String     @id @default(cuid())
  title     String
  kind      FolderKind @default(MANUSCRIPT)
  sortOrder Int        @default(0)
  projectId String
  userId    String
  parentId  String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent   Folder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Folder[] @relation("FolderTree")
  documents Document[]

  @@index([projectId, kind])
  @@index([userId])
  @@index([parentId])
}

model Document {
  id          String       @id @default(cuid())
  title       String
  kind        DocumentKind @default(MANUSCRIPT)
  contentJson Json?
  contentHtml String       @default("")
  plainText   String       @default("")
  wordCount   Int          @default(0)
  charCount   Int          @default(0)
  sortOrder   Int          @default(0)
  isTrash     Boolean      @default(false)
  folderId    String?
  projectId   String
  userId      String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  folder   Folder?   @relation(fields: [folderId], references: [id], onDelete: SetNull)
  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tags     WriterTag[] @relation("DocumentTags")
  resourceLinks ResourceLink[] @relation("DocumentResourceLinks")
  versions DocumentVersion[]

  @@index([projectId, kind, sortOrder])
  @@index([userId])
  @@index([isTrash])
}

model DocumentVersion {
  id                  String   @id @default(cuid())
  documentId          String
  userId              String
  titleSnapshot       String
  contentJsonSnapshot Json?
  contentHtmlSnapshot String   @default("")
  plainTextSnapshot   String   @default("")
  wordCountSnapshot   Int      @default(0)
  changeSummary       String?
  createdAt           DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([documentId, createdAt])
  @@index([userId])
}

model InternalLink {
  id             String       @id @default(cuid())
  projectId      String
  sourceType     LinkableType
  sourceId       String
  targetType     LinkableType?
  targetId       String?
  rawText        String
  normalizedText String
  excerpt        String?
  createdAt      DateTime     @default(now())

  @@index([projectId])
  @@index([sourceType, sourceId])
  @@index([targetType, targetId])
  @@index([normalizedText])
}

model StoryNote {
  id          String        @id @default(cuid())
  title       String
  type        StoryNoteType @default(GENERAL)
  body        String        @default("")
  tagsText    String        @default("")
  linkedDocumentIds String[] @default([])
  projectId   String
  userId      String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tags    WriterTag[] @relation("StoryNoteTags")
  resourceLinks ResourceLink[] @relation("StoryNoteResourceLinks")

  @@index([projectId, type])
  @@index([userId])
}

model ResearchNote {
  id          String   @id @default(cuid())
  title       String
  sourceTitle String?
  sourceUrl   String?
  author      String?
  excerpt     String?
  summary     String   @default("")
  personalNotes String @default("")
  tagsText    String   @default("")
  linkedResourceIds String[] @default([])
  projectId   String
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tags    WriterTag[] @relation("ResearchNoteTags")
  resourceLinks ResourceLink[] @relation("ResearchNoteResourceLinks")

  @@index([projectId])
  @@index([userId])
}

model BrainstormBoard {
  id        String   @id @default(cuid())
  title     String
  projectId String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  columns BrainstormColumn[]
  cards   BrainstormCard[]

  @@index([projectId])
  @@index([userId])
}

model BrainstormColumn {
  id        String   @id @default(cuid())
  title     String
  sortOrder Int      @default(0)
  boardId   String
  projectId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  board   BrainstormBoard @relation(fields: [boardId], references: [id], onDelete: Cascade)
  project Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  cards   BrainstormCard[]

  @@index([boardId, sortOrder])
  @@index([projectId])
}

model BrainstormCard {
  id        String   @id @default(cuid())
  title     String
  body      String   @default("")
  color     String   @default("#f2d7a2")
  tagsText  String   @default("")
  sortOrder Int      @default(0)
  boardId   String
  columnId  String
  projectId String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  board   BrainstormBoard  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  column  BrainstormColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)
  project Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  tags    WriterTag[]      @relation("BrainstormCardTags")
  resourceLinks ResourceLink[] @relation("BrainstormCardResourceLinks")

  @@index([boardId])
  @@index([columnId, sortOrder])
  @@index([projectId])
  @@index([userId])
}

model Resource {
  id          String   @id @default(cuid())
  title       String
  originalName String
  fileName    String
  mimeType    String
  fileSize    Int
  path        String
  notes       String   @default("")
  tagsText    String   @default("")
  projectId   String
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tags    WriterTag[] @relation("ResourceTags")
  links   ResourceLink[]

  @@index([projectId])
  @@index([userId])
  @@index([mimeType])
  @@index([createdAt])
}

model ResourceLink {
  id          String           @id @default(cuid())
  resourceId  String
  linkType    ResourceLinkType
  documentId  String?
  storyNoteId String?
  researchNoteId String?
  brainstormCardId String?
  createdAt   DateTime         @default(now())

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  document Document? @relation("DocumentResourceLinks", fields: [documentId], references: [id], onDelete: Cascade)
  storyNote StoryNote? @relation("StoryNoteResourceLinks", fields: [storyNoteId], references: [id], onDelete: Cascade)
  researchNote ResearchNote? @relation("ResearchNoteResourceLinks", fields: [researchNoteId], references: [id], onDelete: Cascade)
  brainstormCard BrainstormCard? @relation("BrainstormCardResourceLinks", fields: [brainstormCardId], references: [id], onDelete: Cascade)

  @@index([resourceId])
  @@index([linkType])
  @@index([documentId])
  @@index([storyNoteId])
  @@index([researchNoteId])
  @@index([brainstormCardId])
}

model WriterTag {
  id        String   @id @default(cuid())
  name      String
  slug      String
  projectId String?
  createdAt DateTime @default(now())

  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  documents Document[] @relation("DocumentTags")
  storyNotes StoryNote[] @relation("StoryNoteTags")
  researchNotes ResearchNote[] @relation("ResearchNoteTags")
  brainstormCards BrainstormCard[] @relation("BrainstormCardTags")
  resources Resource[] @relation("ResourceTags")

  @@unique([projectId, slug])
  @@index([projectId])
}

model AISettings {
  id              String     @id @default(cuid())
  userId          String     @unique
  provider        AIProvider @default(GROQ)
  apiKeyEncrypted String?
  model           String     @default("llama-3.1-8b-instant")
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([provider])
}
