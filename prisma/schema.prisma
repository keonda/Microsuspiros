generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SongStatus {
  DRAFT
  IN_PROGRESS
  READY
  PUBLISHED
  ARCHIVED
}

enum PlaylistType {
  COMPILATION
  SHORTS_SET
  MOOD_SET
  CUSTOM
}

enum AssetType {
  COVER_ART
  AUDIO_FULL
  AUDIO_SHORT
  VIDEO_SHORT
  VIDEO_FULL
  LYRICS_DOC
  OTHER
}

enum AssetStorageType {
  LOCAL
  EXTERNAL_URL
}

enum PublishPlatform {
  YOUTUBE
  WEBSITE
  WHATSAPP
  INSTAGRAM
  TIKTOK
  OTHER
}

enum PublishContentType {
  FULL_SONG
  SHORT
  PLAYLIST
  EXCERPT
  TEASER
  OTHER
}

enum ReleaseCampaignStatus {
  DRAFT
  PLANNING
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum ReleaseCampaignGoal {
  SONG_LAUNCH
  SHORTS_PUSH
  PLAYLIST_DROP
  WEBSITE_PUSH
  MIXED
}

enum CampaignItemType {
  SONG
  SHORT
  PLAYLIST
  WEBSITE_POST
  EXCERPT
  OTHER
}

enum ScheduledReleaseStatus {
  PLANNED
  SCHEDULED
  PUBLISHED
  SKIPPED
  CANCELED
}

enum ExternalSyncStatus {
  NONE
  LINKED
  SYNCED
  ERROR
}

enum AIGenerationKind {
  YOUTUBE_TITLE
  YOUTUBE_DESCRIPTION
  SHORT_VERSION
  EXCERPT
  TAGS
  HOOK_TEXT
  NOTES
  OTHER
}

model Song {
  id                 String            @id @default(cuid())
  title              String
  slug               String            @unique
  status             SongStatus        @default(DRAFT)
  mood               String?
  theme              String?
  language           String            @default("Spanish")
  fullLyrics         String?
  shortVersion       String?
  hookText           String?
  youtubeTitle       String?
  youtubeDescription String?
  websiteExcerpt     String?
  notes              String?
  hasCoverArt        Boolean           @default(false)
  hasFullVersion     Boolean           @default(false)
  hasShortVersion    Boolean           @default(false)
  publishedYoutube   Boolean           @default(false)
  publishedWebsite   Boolean           @default(false)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  tags               Tag[]
  playlistSongs      PlaylistSong[]
  assets             Asset[]
  aiGenerationLogs   AIGenerationLog[]
  publishEvents      PublishEvent[]
  campaignItems      CampaignItem[]
  scheduledReleases  ScheduledRelease[]
  analyticsSnapshots AnalyticsSnapshot[]

  @@index([status])
  @@index([updatedAt])
  @@index([mood])
  @@index([theme])
}

model Tag {
  id    String @id @default(cuid())
  name  String @unique
  slug  String @unique
  songs Song[]
}

model Playlist {
  id            String         @id @default(cuid())
  title         String
  slug          String         @unique
  description   String?
  type          PlaylistType   @default(CUSTOM)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  playlistSongs PlaylistSong[]
  campaignItems CampaignItem[]
  scheduledReleases ScheduledRelease[]

  @@index([type])
  @@index([updatedAt])
}

model PlaylistSong {
  playlistId String
  songId     String
  position   Int      @default(0)
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  song       Song     @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@id([playlistId, songId])
  @@index([songId])
  @@index([playlistId, position])
}

model Asset {
  id          String           @id @default(cuid())
  songId      String?
  type        AssetType        @default(OTHER)
  storageType AssetStorageType @default(EXTERNAL_URL)
  title       String
  fileName    String?
  mimeType    String?
  fileSize    Int?
  path        String?
  url         String?
  notes       String?
  isPrimary   Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  song        Song?            @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@index([songId])
  @@index([type])
  @@index([createdAt])
}

model AIGenerationLog {
  id        String           @id @default(cuid())
  songId    String?
  kind      AIGenerationKind @default(OTHER)
  provider  String           @default("mock")
  prompt    String
  result    String
  accepted  Boolean          @default(false)
  createdAt DateTime         @default(now())
  song      Song?            @relation(fields: [songId], references: [id], onDelete: SetNull)

  @@index([songId])
  @@index([kind])
  @@index([createdAt])
}

model PublishEvent {
  id          String             @id @default(cuid())
  songId      String
  platform    PublishPlatform    @default(OTHER)
  contentType PublishContentType @default(OTHER)
  publishedAt DateTime           @default(now())
  url         String?
  externalId  String?
  externalUrl String?
  thumbnailUrl String?
  syncStatus  ExternalSyncStatus @default(NONE)
  lastSyncedAt DateTime?
  syncError   String?
  notes       String?
  createdAt   DateTime           @default(now())
  song        Song               @relation(fields: [songId], references: [id], onDelete: Cascade)
  analyticsSnapshots AnalyticsSnapshot[]

  @@index([songId])
  @@index([platform])
  @@index([publishedAt])
  @@index([externalId])
  @@index([syncStatus])
}

model ReleaseCampaign {
  id                String                @id @default(cuid())
  title             String
  slug              String                @unique
  description       String?
  status            ReleaseCampaignStatus @default(DRAFT)
  goal              ReleaseCampaignGoal   @default(MIXED)
  startDate         DateTime?
  endDate           DateTime?
  notes             String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  items             CampaignItem[]
  scheduledReleases ScheduledRelease[]

  @@index([status])
  @@index([goal])
  @@index([startDate])
}

model CampaignItem {
  id         String           @id @default(cuid())
  campaignId String
  songId     String?
  playlistId String?
  itemType   CampaignItemType @default(OTHER)
  title      String?
  notes      String?
  priority   Int              @default(0)
  createdAt  DateTime         @default(now())
  campaign   ReleaseCampaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  song       Song?            @relation(fields: [songId], references: [id], onDelete: SetNull)
  playlist   Playlist?        @relation(fields: [playlistId], references: [id], onDelete: SetNull)

  @@index([campaignId])
  @@index([songId])
  @@index([playlistId])
  @@index([priority])
}

model ScheduledRelease {
  id          String                 @id @default(cuid())
  songId      String?
  playlistId  String?
  campaignId  String?
  platform    PublishPlatform        @default(OTHER)
  contentType PublishContentType     @default(OTHER)
  status      ScheduledReleaseStatus @default(PLANNED)
  title       String
  scheduledFor DateTime?
  publishedAt DateTime?
  notes       String?
  ctaText     String?
  url         String?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  song        Song?                  @relation(fields: [songId], references: [id], onDelete: SetNull)
  playlist    Playlist?              @relation(fields: [playlistId], references: [id], onDelete: SetNull)
  campaign    ReleaseCampaign?       @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([songId])
  @@index([playlistId])
  @@index([campaignId])
  @@index([platform])
  @@index([contentType])
  @@index([status])
  @@index([scheduledFor])
}

model UserPreference {
  id        String   @id @default(cuid())
  userId    String?
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model AnalyticsSnapshot {
  id             String          @id @default(cuid())
  songId         String?
  publishEventId String?
  platform       PublishPlatform @default(OTHER)
  snapshotDate   DateTime
  views          Int?
  likes          Int?
  comments       Int?
  shares         Int?
  watchTime      Int?
  ctr            Float?
  retention      Float?
  rawJson        Json?
  createdAt      DateTime        @default(now())
  song           Song?           @relation(fields: [songId], references: [id], onDelete: SetNull)
  publishEvent   PublishEvent?   @relation(fields: [publishEventId], references: [id], onDelete: SetNull)

  @@index([songId])
  @@index([publishEventId])
  @@index([platform])
  @@index([snapshotDate])
}
