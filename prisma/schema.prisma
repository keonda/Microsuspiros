generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SongStatus {
  DRAFT
  IN_PROGRESS
  READY
  PUBLISHED
  ARCHIVED
}

enum PlaylistType {
  COMPILATION
  SHORTS_SET
  MOOD_SET
  CUSTOM
}

enum AssetType {
  COVER_ART
  AUDIO_FULL
  AUDIO_SHORT
  VIDEO_SHORT
  VIDEO_FULL
  LYRICS_DOC
  OTHER
}

enum AssetStorageType {
  LOCAL
  EXTERNAL_URL
}

enum PublishPlatform {
  YOUTUBE
  WEBSITE
  WHATSAPP
  INSTAGRAM
  TIKTOK
  OTHER
}

enum PublishContentType {
  FULL_SONG
  SHORT
  PLAYLIST
  EXCERPT
  OTHER
}

enum AIGenerationKind {
  YOUTUBE_TITLE
  YOUTUBE_DESCRIPTION
  SHORT_VERSION
  EXCERPT
  TAGS
  HOOK_TEXT
  NOTES
  OTHER
}

model Song {
  id                 String            @id @default(cuid())
  title              String
  slug               String            @unique
  status             SongStatus        @default(DRAFT)
  mood               String?
  theme              String?
  language           String            @default("Spanish")
  fullLyrics         String?
  shortVersion       String?
  hookText           String?
  youtubeTitle       String?
  youtubeDescription String?
  websiteExcerpt     String?
  notes              String?
  hasCoverArt        Boolean           @default(false)
  hasFullVersion     Boolean           @default(false)
  hasShortVersion    Boolean           @default(false)
  publishedYoutube   Boolean           @default(false)
  publishedWebsite   Boolean           @default(false)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  tags               Tag[]
  playlistSongs      PlaylistSong[]
  assets             Asset[]
  aiGenerationLogs   AIGenerationLog[]
  publishEvents      PublishEvent[]

  @@index([status])
  @@index([updatedAt])
  @@index([mood])
  @@index([theme])
}

model Tag {
  id    String @id @default(cuid())
  name  String @unique
  slug  String @unique
  songs Song[]
}

model Playlist {
  id            String         @id @default(cuid())
  title         String
  slug          String         @unique
  description   String?
  type          PlaylistType   @default(CUSTOM)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  playlistSongs PlaylistSong[]

  @@index([type])
  @@index([updatedAt])
}

model PlaylistSong {
  playlistId String
  songId     String
  position   Int      @default(0)
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  song       Song     @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@id([playlistId, songId])
  @@index([songId])
  @@index([playlistId, position])
}

model Asset {
  id          String           @id @default(cuid())
  songId      String?
  type        AssetType        @default(OTHER)
  storageType AssetStorageType @default(EXTERNAL_URL)
  title       String
  fileName    String?
  mimeType    String?
  fileSize    Int?
  path        String?
  url         String?
  notes       String?
  isPrimary   Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  song        Song?            @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@index([songId])
  @@index([type])
  @@index([createdAt])
}

model AIGenerationLog {
  id        String           @id @default(cuid())
  songId    String?
  kind      AIGenerationKind @default(OTHER)
  provider  String           @default("mock")
  prompt    String
  result    String
  accepted  Boolean          @default(false)
  createdAt DateTime         @default(now())
  song      Song?            @relation(fields: [songId], references: [id], onDelete: SetNull)

  @@index([songId])
  @@index([kind])
  @@index([createdAt])
}

model PublishEvent {
  id          String             @id @default(cuid())
  songId      String
  platform    PublishPlatform    @default(OTHER)
  contentType PublishContentType @default(OTHER)
  publishedAt DateTime           @default(now())
  url         String?
  notes       String?
  createdAt   DateTime           @default(now())
  song        Song               @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@index([songId])
  @@index([platform])
  @@index([publishedAt])
}
